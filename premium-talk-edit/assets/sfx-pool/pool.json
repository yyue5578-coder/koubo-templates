 "rules": {
  "_说明": "gk_bed.py --pool 按这里的规则挑变体。数值都可以改；改完重跑 gk_bed.py 即可。详细解释见 references/sfx.md。",
  "max_len": {
   "whoosh": 0.8,
   "pop": 0.35,
   "tick": 0.2,
   "hit": 0.6,
   "swipe": 0.6,
   "ok": 0.9,
   "no": 0.7,
   "key": 0.2
  },
  "align_peak": [
   "whoosh"
  ],
  "roles": {
   "whoosh": [
    "panel",
    "hook",
    "full"
   ],
   "pop": [
    "card",
    "bubble"
   ],
   "tick": [
    "list",
    "check",
    "mark"
   ],
   "hit": [
    "big",
    "small"
   ],
   "swipe": [
    "highlight",
    "strike",
    "page"
   ],
   "ok": [
    "verdict",
    "save"
   ],
   "no": [
    "cross",
    "risk"
   ]
  },
  "role_cn": {
   "panel": "上卡下人底色展开",
   "hook": "钩子/章节/开场",
   "full": "全屏讲解/片尾进场",
   "card": "卡片进场",
   "bubble": "气泡/标注",
   "list": "列表逐项",
   "check": "打勾",
   "mark": "框选",
   "big": "主数字落定",
   "small": "次要数字落定",
   "highlight": "荧光笔",
   "strike": "划掉",
   "page": "翻页",
   "doc": "文件滑入",
   "verdict": "清单结论",
   "save": "片尾收藏",
   "cross": "打叉",
   "risk": "风险提示",
   "type": "打字"
  },
  "fixed": {
   "swipe.doc": "longest"
  },
  "frequent_not_longest": [
   "whoosh.panel",
   "pop.card",
   "tick.list",
   "tick.check",
   "swipe.highlight"
  ],
  "heavy_not_shortest": [
   "whoosh.hook",
   "hit.big"
  ],
  "role_gain_db": {
   "hook": 2,
   "big": 2,
   "small": -2,
   "bubble": -2,
   "mark": 1,
   "page": -3,
   "doc": -2,
   "risk": 1
  },
  "run": {
   "roles": [
    "tick.list",
    "tick.check",
    "pop.bubble"
   ],
   "window": 1.5,
   "step": 0.03,
   "max": 0.09
  },
  "density": {
   "tick": {
    "per_seconds": 10,
    "max": 7
   }
  },
  "vary": {
   "pitch": 0.02,
   "gain_db": 1.5
  },
  "typing": {
   "rate": 9,
   "jitter": 0.25
  },
  "rel_db": {
   "whoosh": -1,
   "pop": 4,
   "tick": 3,
   "hit": 6,
   "swipe": -2,
   "ok": 3,
   "no": 3
  },
  "peak_rel": {
   "key": 17
  },
  "peak_max": -6,
  "_响度说明": "每类的 50 ms RMS 峰值 = 人声中位数 + rel_db（用户认可的起步值）；按键按峰值：人声 + peak_rel；任何声音峰值不超过 peak_max。场合再加减 role_gain_db。"
 }
}